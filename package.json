{
  "name": "single_maximizer_back",
  "version": "1.0.0",
  "type": "module",
  "description": "Single Maximizer Live App.",
  "main": "server.ts",
  "scripts": {
    "test": "jest --watchAll --verbose --detectOpenHandles --testTimeout=10000",
    "start": "tsc --watch",
    "server": "nodemon --watch backend --exec tsx ./backend/server.ts",
    "client": "npm run dev --prefix client",
    "webhook": "stripe listen --forward-to localhost:5000/api/webhook",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run webhook\"",
    "live": "concurrently \"npm run server\" \"npm run webhook\""
  },
  "author": "Andrew",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.669.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "buffer": "^6.0.3",
    "colors": "^1.4.0",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-handler": "^1.2.0",
    "express-session": "^1.18.1",
    "generate-password": "^1.7.1",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^9.4.1",
    "mongoose": "^7.8.2",
    "multer": "^1.4.5-lts.1",
    "node-schedule": "^2.1.1",
    "react-bootstrap": "^2.10.5",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.11",
    "@types/node-schedule": "^2.1.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
