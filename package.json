{
  "name": "single_maximizer_back",
  "version": "1.0.0",
  "type": "module",
  "description": "Single Maximizer Live App.",
  "main": "server.ts",
  "scripts": {
    "test": "jest --watchAll --verbose --detectOpenHandles --testTimeout=10000",
    "start": "tsc --watch",
    "server": "nodemon --watch ./backend --exec tsx ./backend/server.ts",
    "compiler": "tsc --build --watch",
    "client": "npm run dev --prefix client",
    "webhook": "stripe listen --forward-to localhost:5000/api/webhook",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run webhook\"",
    "live": "concurrently \"npm run server\" \"npm run webhook\"",
    "build": "concurrently \"npm run compiler\" \"npm run server\""
  },
  "tasks": [
    {
      "type": "typescript",
      "tsconfig": "tsconfig.json",
      "problemMatcher": [
        "$tsc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "author": "Andrew",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "buffer": "^6.0.3",
    "colors": "^1.4.0",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-session": "^1.18.1",
    "generate-password": "^1.7.1",
    "http-status-codes": "^2.3.0",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^10.4.0",
    "mongoose": "^8.9.2",
    "multer": "^1.4.5-lts.1",
    "node-schedule": "^2.1.1",
    "react-bootstrap": "^2.10.7",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-schedule": "^2.1.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
