{
  "name": "single_maximizer_back",
  "version": "1.0.0",
  "type": "module",
  "description": "Single Maximizer Live App.",
  "main": "server.ts",
  "scripts": {
    "start": "tsc --watch",
    "server": "nodemon --watch backend --exec tsx ./backend/server.ts",
    "client": "npm run dev --prefix client",
    "webhook": "stripe listen --forward-to localhost:5000/api/webhook",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run webhook\"",
    "live": "concurrently \"npm run server\" \"npm run webhook\""
  },
  "author": "Andrew",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "buffer": "^6.0.3",
    "colors": "^1.4.0",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-session": "^1.18.0",
    "generate-password": "^1.7.1",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.0",
    "mailgun.js": "^9.2.0",
    "mongoose": "^7.3.0",
    "multer": "^1.4.5-lts.1",
    "node-schedule": "^2.1.1",
    "react-bootstrap": "^2.10.4",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
